# Server configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Security
JWT_SECRET=demo-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# IoT Device Authentication
DEVICE_API_KEY=demo-device-key-change-me

# AI Configuration (gemini | anthropic | openai | mock)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Telegram Notifications (Optional - leave blank to use simulated channel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Simulation Flags
SIMULATE_NOTIFICATION_FAILURE=false
SIMULATOR_AUTO_START=true
SIMULATOR_SCENARIO=normal_rest
SIMULATOR_TARGET_URL=http://localhost:8000/api/v1/readings
SIMULATOR_DEVICE_ID=ESP32-VITAL-01
